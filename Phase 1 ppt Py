birthdays = []

while True:
    print("\n--- Birthday Reminder ---")
    print("1. Add Birthday")
    print("2. Search Birthday")
    print("3. Delete Birthday")
    print("4. View All Birthdays")
    print("5. Exit")

    choice = input("Enter choice: ")

    if choice == "1":
        name = input("Enter name: ")
        dob = input("Enter birthday (DD-MM-YYYY): ")
        relation = input("Enter relation: ")
        contact = input("Enter contact: ")

        person = {
            "name": name,
            "dob": dob,
            "relation": relation,
            "contact": contact
        }

        birthdays.append(person)
        print("Birthday added successfully!")

    elif choice == "2":
        name = input("Enter name to search: ")

        for person in birthdays:
            if person["name"].lower() == name.lower():
                print("Name:", person["name"])
                print("Birthday:", person["dob"])
                print("Relation:", person["relation"])
                print("Contact:", person["contact"])
                break
        else:
            print("Birthday not found!")

    elif choice == "3":
        name = input("Enter name to delete: ")

        for person in birthdays:
            if person["name"].lower() == name.lower():
                birthdays.remove(person)
                print("Birthday deleted!")
                break
        else:
            print("Birthday not found!")

    elif choice == "4":
        if len(birthdays) == 0:
            print("No birthdays saved.")
        else:
            for person in birthdays:
                print(person["name"], "-", person["dob"])

    elif choice == "5":
        print("Thank you!")
        break

    else:
        print("Invalid choice!")
